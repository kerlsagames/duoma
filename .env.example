=======================================
# Copy to .env for local `expo start`.
# Add the same names in Vercel / Netlify project settings.
# Never commit VAPID_PRIVATE_KEY.
#
# Generate your own keys (do this for production):
#   npx web-push generate-vapid-keys

EXPO_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Local only. Leave empty on Vercel/Netlify so the app posts to same-origin /api/push/send
EXPO_PUBLIC_PUSH_API=http://127.0.0.1:43128

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Lets the 18:00 UTC cron fan the daily question out to both phones.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
